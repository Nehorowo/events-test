{
  "name": "@slotwise/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "esbuild src/main.ts src/worker.ts src/admin.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --sourcemap",
    "start": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
