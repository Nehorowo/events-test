# Copy to .env and fill in. Only APP_SECRET is required to start locally.

# Public URL people use to reach the app (emails and OAuth redirects point here).
APP_URL=http://localhost:8080
# Signs client cancel/reschedule links. Generate with: openssl rand -hex 32
APP_SECRET=
# Postgres password for the bundled database.
POSTGRES_PASSWORD=slotwise

# ── Email ──────────────────────────────────────────────────────────────────────
# With RESEND_API_KEY set, mail goes through Resend. Otherwise it goes to
# SMTP_URL, which defaults to the bundled Mailpit inbox at http://localhost:8025.
EMAIL_FROM=Slotwise <bookings@example.com>
RESEND_API_KEY=
SMTP_URL=

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (optional) ─────────────────────────────────────────────────────────
# Without these, billing runs in test mode: "Upgrade" switches plans instantly.
# Webhook endpoint: ${APP_URL}/api/stripe/webhook with events
# checkout.session.completed, customer.subscription.*, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Web push (optional) ───────────────────────────────────────────────────────
# Generated and stored in the database on first start when left empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ── Analytics (optional, self-hosted Umami) ──────────────────────────────────
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
